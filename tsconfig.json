{
  "exclude": ["node_modules", "dist", "sistema-forja-replica-main", "components/forja/components/Map.tsx"],
  "compilerOptions": {
    "target": "ES2022",
    "experimentalDecorators": true,
    "useDefineForClassFields": false,
    "module": "ESNext",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "skipLibCheck": true,
    "types": [
      "node"
    ],
    "moduleResolution": "bundler",
    "isolatedModules": true,
    "moduleDetection": "force",
    "allowJs": true,
    "jsx": "react-jsx",
    "paths": {
      "@/*": [
        "./*"
      ],
      "@forja/*": [
        "./components/forja/*"
      ]
    },
    "allowImportingTsExtensions": true,
    "noEmit": true
  }
}